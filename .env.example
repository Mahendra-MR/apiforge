# Backend server
PORT=4000
NODE_ENV=development

# SQLite database file. Created (and its schema applied) automatically on
# first run — nothing extra to install or start, unlike the Postgres setup
# this replaced. The Electron desktop build overrides this to a path inside
# the OS's per-user app-data folder.
DB_PATH=./data/apiforge.db

# AI provider (Anthropic Claude). Never expose this to the frontend.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-5

# Request execution
REQUEST_TIMEOUT_MS=30000
MAX_RESPONSE_BODY_BYTES=5000000

# Rate limiting (AI endpoints)
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20
